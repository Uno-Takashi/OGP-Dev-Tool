{
  "manifest_version": 3,
  "name": "OGP Dev Tool",
  "description": "A developer tool to simulate OGP drawing results.Localhost results can also be easily previewed.",
  "version": "1.1.0",
  "devtools_page": "devtools_page.html",
  "options_ui": {
    "page": "options.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "js": ["js/vendor.js", "js/content_script.js"]
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [],
  "host_permissions": ["<all_urls>"]
}
