{
  "name": "ogp-dev-tool",
  "version": "2.1.1",
  "description": "A validation simulator for developers to review OGP display results.",
  "main": "index.js",
  "scripts": {
    "watch": "webpack --config webpack/webpack.dev.js --watch",
    "build": "webpack --config webpack/webpack.prod.js",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"public/manifest.json\" \"tsconfig.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"public/manifest.json\" \"tsconfig.json\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "author": "Uno Takashi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Uno-Takashi/OGP-Dev-Tool.git"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@reduxjs/toolkit": "^2.5.0",
    "@tailwindcss/postcss": "^4.3.0",
    "antd": "^5.24.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^0.469.0",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-redux": "^9.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-onboarding": "^10.4.0",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/react-webpack5": "^10.4.1",
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.20",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-storybook": "^10.4.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "glob": "^13.0.6",
    "postcss": "^8.5.0",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "sass": "^1.83.0",
    "sass-loader": "^17.0.0",
    "sharp": "^0.34.5",
    "storybook": "^10.4.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
