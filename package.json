{
  "name": "ogp-dev-tool",
  "version": "2.2.0",
  "description": "A validation simulator for developers to review OGP display results.",
  "main": "index.js",
  "scripts": {
    "watch": "rspack --config rspack/rspack.dev.js --watch",
    "build": "rspack --config rspack/rspack.prod.js",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"public/manifest.json\" \"tsconfig.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"public/manifest.json\" \"tsconfig.json\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "author": "Uno Takashi",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Uno-Takashi/OGP-Dev-Tool.git"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "antd": "^6.6.8",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.66.0",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-redux": "^9.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@rspack/cli": "^2.3.0",
    "@rspack/core": "^2.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/react-webpack5": "^10.6.5",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.2",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-unicorn": "^65.0.1",
    "glob": "^13.0.6",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.5",
    "style-loader": "^4.0.0",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2"
  }
}
